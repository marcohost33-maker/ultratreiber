{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udx.invalid/contracts/request-0.1.schema.json",
  "title": "UDX reference request 0.1 (structural contract)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request_id", "capability", "params"],
  "properties": {
    "version": {"const": "udx/0.1"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "capability": {"type": "string", "minLength": 3, "maxLength": 72, "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
    "params": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"capability": {"const": "device.capabilities.list"}}, "required": ["capability"]},
     "then": {"properties": {"params": {"type": "object", "maxProperties": 0}}}},
    {"if": {"properties": {"capability": {"const": "object.metadata.read"}}, "required": ["capability"]},
     "then": {"properties": {"params": {"type": "object", "required": ["object_id"], "additionalProperties": false,
       "properties": {"object_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}}}}}
  ]
}
